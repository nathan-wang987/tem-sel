{
  "name": "pixel-warden",
  "version": "1.0.0",
  "private": true,
  "description": "像素守卫 Pixel Warden - 横版打怪升级网页小游戏 (TypeScript + React + Canvas 像素 3D 渲染)",
  "license": "MIT",
  "scripts": {
    "build": "node tools/build.mjs",
